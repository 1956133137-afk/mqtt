<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEFEF"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="center_vertical"
        android:background="#FFFFFF">

        <ImageButton
            android:id="@+id/ibt_back"
            android:layout_width="115dp"
            android:layout_height="50dp"
            android:layout_marginStart="44dp"
            android:background="@drawable/shape_btn_bg_white"
            android:src="@drawable/ic_back" />
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:paddingEnd="159dp"
            android:gravity="center"
            android:text="@string/dishes_manage"
            android:textSize="36sp"
            android:textColor="#101010"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="70dp"
        android:layout_marginTop="40dp"
        android:layout_marginStart="69dp"
        android:gravity="center_vertical"
        android:background="@drawable/shape_normal_bg"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/spinner_text"
            android:layout_width="0dp"
            android:layout_weight="3"
            android:layout_height="match_parent"
            android:layout_marginStart="15dp"
            android:gravity="left"
            android:paddingTop="8dp"
            android:text="@string/meal_category"
            android:textSize="36sp"
            android:textColor="#4F4F4F"/>

        <ImageButton
            android:id="@+id/spinner_img"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:background="@color/transparency"
            android:src="@drawable/ic_dropdown"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_grid_manage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="69dp"
        android:layout_marginEnd="69dp"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="40dp"
        android:overScrollMode="never"/>

</LinearLayout>