<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_bg_white_20"
    android:orientation="vertical"
    android:padding="40dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:minWidth="800dp"
        android:text="菜品信息详情"
        android:textAlignment="center"
        android:textColor="#333333"
        android:textSize="42sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:minWidth="1200dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dish_id"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:text="菜品ID"
            android:textAlignment="center"
            android:textColor="#333333"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/dish_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:text="菜品名称"
            android:textAlignment="center"
            android:textColor="#333333"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/dish_count"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:text="菜品数量"
            android:textAlignment="center"
            android:textColor="#333333"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/dish_price"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:text="菜品单价"
            android:textAlignment="center"
            android:textColor="#333333"
            android:textSize="32sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_dishes"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:minHeight="80dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="菜品总金额："
            android:textColor="#333333"
            android:textSize="23sp" />

        <TextView
            android:id="@+id/dishes_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="￥12"
            android:textColor="@color/red"
            android:textSize="40sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_close"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_bg_blue_1"
        android:text="关闭"
        android:textColor="@color/white"
        android:textSize="32sp" />
</LinearLayout>