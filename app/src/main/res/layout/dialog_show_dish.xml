<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/back_auto_verify"
        android:layout_width="100dp"
        android:layout_height="100dp" />

    <Button
        android:id="@+id/btn_back"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_alignParentRight="true"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="60dp"
        android:background="@drawable/click_button_blue"
        android:gravity="center"
        android:text="@string/btn_back"
        android:textColor="#FFFFFF"
        android:textSize="40sp" />

<!--    <Button-->
<!--        android:id="@+id/btn_close"-->
<!--        android:layout_width="200dp"-->
<!--        android:layout_height="80dp"-->
<!--        android:layout_marginTop="60dp"-->
<!--        android:layout_marginEnd="40dp"-->
<!--        android:layout_toStartOf="@+id/btn_back"-->
<!--        android:background="@drawable/click_button_blue"-->
<!--        android:gravity="center"-->
<!--        android:text="退出"-->
<!--        android:textColor="#FFFFFF"-->
<!--        android:textSize="40sp"-->
<!--        android:visibility="gone" />-->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="700dp"
            android:layout_height="700dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_pay_success" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="50dp">

                <TextView
                    android:id="@+id/person_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="何**"
                    android:textColor="#347CAF"
                    android:textSize="70sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="核销成功"
                    android:textColor="#347CAF"
                    android:textSize="70sp" />
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="50dp"
                android:paddingEnd="100dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="核销菜品："
                        android:textColor="#6C6C6C"
                        android:textSize="50sp" />

                    <TextView
                        android:id="@+id/tv_dish"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#6C6C6C"
                        android:textSize="50sp" />
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未核销窗口："
                        android:textColor="#6C6C6C"
                        android:textSize="50sp" />

                    <TextView
                        android:id="@+id/tv_window"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#6C6C6C"
                        android:textSize="50sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未核销菜品："
                        android:textColor="#6C6C6C"
                        android:textSize="50sp" />

                    <TextView
                        android:id="@+id/tv_not_dish"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#6C6C6C"
                        android:textSize="50sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="核销时间："
                        android:textColor="#6C6C6C"
                        android:textSize="50sp" />

                    <TextView
                        android:id="@+id/tv_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#6C6C6C"
                        android:textSize="50sp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>