<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp"
    android:orientation="vertical"
    tools:context=".activitys.fragment.UploadFaceFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_module_bg"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:padding="5dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="用户姓名:"
                android:textColor="#4F4F4F"
                android:textSize="35sp" />

            <EditText
                android:id="@+id/user_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:hint="请输入用户姓名"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#4F4F4F"
                android:textSize="35sp"
                tools:ignore="NestedWeights" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="手机号:"
                android:textColor="#4F4F4F"
                android:textSize="35sp" />

            <EditText
                android:id="@+id/user_phone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:hint="请输入手机号"
                android:inputType="phone"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#4F4F4F"
                android:textSize="35sp"
                tools:ignore="NestedWeights" />
        </LinearLayout>

        <Button
            android:id="@+id/query_order"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:background="@drawable/select_btn_bg_blue_press"
            android:outlineProvider="none"
            android:padding="5dp"
            android:text="查询"
            android:textColor="#FFFFFF"
            android:textSize="35sp" />

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_marginHorizontal="5dp"
            android:background="@drawable/shape_bg_white_10"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/user_rec"
                android:layout_margin="10dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

        </LinearLayout>
        <RelativeLayout
            android:layout_marginHorizontal="5dp"
            android:padding="24dp"
            android:background="@drawable/shape_bg_white_10"
            android:layout_weight="3"
            android:layout_width="0dp"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/name_text"
                android:text="姓名:"
                android:textSize="48sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_width="200dp"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/grade_text"
                android:text="班级:"
                android:textSize="48sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_below="@id/name_text"
                android:textColor="@color/black"
                android:layout_width="200dp"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/phone_text"
                android:text="手机号:"
                android:textSize="48sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_below="@id/grade_text"
                android:textColor="@color/black"
                android:layout_width="200dp"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/name"
                android:textSize="48sp"
                android:textStyle="bold"
                android:layout_toEndOf="@id/name_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/grade"
                android:textSize="48sp"
                android:textStyle="bold"
                android:layout_alignTop="@id/grade_text"
                android:layout_toEndOf="@id/grade_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/phone"
                android:textSize="48sp"
                android:textStyle="bold"
                android:layout_alignTop="@id/phone_text"
                android:layout_toEndOf="@id/phone_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:id="@+id/btn_box"
                android:layout_marginTop="40dp"
                android:orientation="horizontal"
                android:layout_below="@id/phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/get_face"
                    android:text="录入人脸"
                    android:textSize="48sp"
                    android:textColor="@color/white"
                    android:layout_margin="10dp"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp"
                    android:layout_marginTop="30dp"
                    android:background="@drawable/shape_bg_blue_10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <Button
                    android:id="@+id/upload_face"
                    android:text="上传人脸"
                    android:textSize="48sp"
                    android:textColor="@color/white"
                    android:layout_margin="10dp"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp"
                    android:layout_marginTop="30dp"
                    android:background="@drawable/shape_bg_blue_10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/face_img"
                android:layout_marginEnd="50dp"
                android:layout_alignParentEnd="true"
                android:layout_width="300dp"
                android:layout_height="400dp"/>

            <TextView
                android:id="@+id/upload_text"
                android:textSize="48sp"
                android:textStyle="bold"
                android:textColor="@color/pass_color"
                android:layout_below="@id/btn_box"
                android:layout_marginTop="24dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/upload_img_text"
                android:textSize="48sp"
                android:textStyle="bold"
                android:textColor="@color/pass_color"
                android:layout_below="@id/upload_text"
                android:layout_marginTop="24dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </RelativeLayout>
    </LinearLayout>

</LinearLayout>