<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/second_display"
    android:background="#F5F5F5"
    android:orientation="vertical"
    android:layout_width="1280px"
    android:layout_height="800px">


        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:background="#2A92FA"
            android:layout_height="100px">

            <TextView
                android:id="@+id/tv_second_name"
                android:layout_weight="2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:paddingLeft="15px"
                android:text="好味儿"
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:textSize="70px" />

            <TextView
                android:id="@+id/tv_second_hit"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="match_parent"
                android:paddingLeft="15px"
                android:text="请检查菜品和扣款明细是否一致"
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:textSize="35px" />

            <ImageView
                android:id="@+id/ib_second_cancel"
                android:layout_width="wrap_content"
                android:layout_height="60px"
                android:paddingLeft="20px"
                android:paddingTop="20px"
                android:paddingBottom="20px"
                android:paddingRight="30px"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_close"
                android:scaleType="centerCrop" />

        </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:layout_marginTop="20px"
        android:layout_height="540px">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_second_detail"
            android:layout_width="900px"
            android:layout_height="540px" />

        <ImageView
            android:layout_marginLeft="40px"
            android:layout_width="300px"
            android:layout_toRightOf="@+id/rv_second_detail"
            android:layout_height="match_parent"
            />

        <TextView
            android:id="@+id/tv_second_text_hit"
            android:layout_width="700px"
            android:layout_height="400px"
            android:background="@drawable/wait_hit_bg"
            android:layout_centerInParent="true"
            android:text="请等待收银员确认..."
            android:gravity="center"
            android:textSize="40sp"
            android:visibility="gone"
            android:textColor="@color/black"/>

    </RelativeLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:background="@color/white"
            android:orientation="horizontal"
            android:layout_marginTop="20px"
            android:layout_marginBottom="20px"
            android:weightSum="2"
            android:layout_height="100px">

            <TextView
                android:id="@+id/tv_second_total"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="合计:￥ 0.00"
                android:gravity="center"
                android:textSize="40px"
                android:textStyle="bold"
                android:layout_height="match_parent"/>

            <Button
                android:layout_weight="1"
                android:id="@+id/bt_second_sure"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:textSize="40px"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/common_bt_bg"
                android:text="确定" />

        </LinearLayout>


</LinearLayout>