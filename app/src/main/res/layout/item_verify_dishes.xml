<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/click_button_white"
    android:orientation="vertical"
    android:padding="5dp"
    android:layout_marginBottom="5dp">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="核销时间"
            android:textSize="18sp"
            android:layout_marginBottom="10dp" />
        <TextView
            android:id="@+id/verify_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:text="2024-08-05 17:16:00"
            android:textSize="18sp"
            android:layout_marginBottom="10dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="已核销菜品"
            android:textSize="18sp"
            android:layout_marginBottom="10dp" />
        <TextView
            android:id="@+id/verify_dishes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="凉拌黄瓜,1份"
            android:textSize="18sp"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="10dp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="未核销菜品"
            android:textSize="18sp"
            android:layout_marginBottom="10dp" />
        <TextView
            android:id="@+id/verify_un_dish"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="牛奶,1份"
            android:textSize="18sp"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="10dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="未核销窗口"
            android:textSize="18sp"
            android:layout_marginBottom="10dp" />
        <TextView
            android:id="@+id/verify_window"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="窗口B"
            android:textSize="18sp"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="10dp" />
    </LinearLayout>

</LinearLayout>