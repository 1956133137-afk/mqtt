<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="300dp"
        android:layout_height="290dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="53dp"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="280dp"
        android:background="@drawable/ccb_img" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="134dp"
        android:layout_marginTop="117dp"
        android:text="智慧食堂"
        android:textColor="#3894FF"
        android:textSize="45sp"
        android:textStyle="bold" />

    <RelativeLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="50dp"
        android:layout_marginStart="50dp">
        <LinearLayout
            android:id="@+id/verify_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="总订餐数:"
                    android:textColor="#4F4F4F"
                    android:textSize="23sp" />

                <TextView
                    android:id="@+id/tv_total_order"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="#4F4F4F"
                    android:textSize="23sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="总核销数:"
                    android:textColor="#4F4F4F"
                    android:textSize="23sp" />

                <TextView
                    android:id="@+id/tv_total_verify"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="#4F4F4F"
                    android:textSize="23sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未核销数:"
                    android:textColor="#4F4F4F"
                    android:textSize="23sp" />

                <TextView
                    android:id="@+id/tv_un_verify"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="#4F4F4F"
                    android:textSize="23sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_order_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="餐别订餐数:"
                    android:textColor="#4F4F4F"
                    android:textSize="23sp" />

                <TextView
                    android:id="@+id/tv_meal_order"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="#4F4F4F"
                    android:textSize="23sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_verify_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="餐别核销数:"
                    android:textColor="#4F4F4F"
                    android:textSize="23sp" />

                <TextView
                    android:id="@+id/tv_meal_verify"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="#4F4F4F"
                    android:textSize="23sp" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="400dp"
        android:layout_height="380dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="41dp"
        android:background="@drawable/shape_verify_bg"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:text="订餐核销信息"
            android:textColor="#454545"
            android:textSize="25sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_dishes"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_code"
        android:layout_width="200dp"
        android:layout_height="70dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="440dp"
        android:layout_marginEnd="283dp"
        android:text="订餐核销"
        android:gravity="center"
        android:textSize="32sp"
        android:textColor="#ffffff"
        android:background="@drawable/shape_btn_orange"/>

    <TextView
        android:id="@+id/tv_face"
        android:layout_width="200dp"
        android:layout_height="70dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="440dp"
        android:layout_marginEnd="56dp"
        android:background="@drawable/shape_btn_orange"
        android:gravity="center"
        android:text="刷脸核销"
        android:textColor="#ffffff"
        android:textSize="32sp" />

    <ViewFlipper
        android:id="@+id/vf_slidesshow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:flipInterval="5000"
        android:inAnimation="@anim/slide_in1"
        android:outAnimation="@anim/slide_out1"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_fp_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:background="#B3FFFFFF"
        android:drawableRight="@mipmap/ct"
        android:drawablePadding="15dp"
        android:fontFamily="@font/kai"
        android:gravity="center"
        android:paddingLeft="20dp"
        android:paddingTop="10dp"

        android:paddingRight="20dp"
        android:textColor="@color/sky_color"
        android:textSize="40sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <View
        android:id="@+id/v_setting"
        android:layout_width="150dp"
        android:layout_height="100dp"
        android:layout_alignParentRight="true" />

    <LinearLayout
        android:id="@+id/ll_pay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_marginRight="50px"
        android:layout_marginBottom="20px"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_amount"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="50px"
            android:background="@color/white"
            android:gravity="center"
            android:padding="5px"
            android:text="￥：15.66"
            android:textColor="@color/table_unselet"
            android:textSize="35sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_is_pay"
            android:layout_width="200px"
            android:layout_height="wrap_content"
            android:background="@drawable/click_button"
            android:padding="10dp"
            android:text="码卡"
            android:textColor="@color/table_unselet"
            android:textSize="35sp"
            android:textStyle="bold" />


        <Button
            android:id="@+id/btn_face_pay"
            android:layout_width="200px"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50px"
            android:background="@drawable/click_button"
            android:padding="10dp"
            android:text="刷脸"
            android:textColor="@color/table_unselet"
            android:textSize="35sp"
            android:textStyle="bold" />


    </LinearLayout>






</RelativeLayout>