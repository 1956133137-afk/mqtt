<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="70px"
    android:padding="5px"
    android:layout_marginBottom="10px"
    android:background="@drawable/shape_module_bg"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tv_item_name"
        android:layout_width="0px"
        android:layout_weight="5"
        android:layout_height="match_parent"

        android:paddingStart="10px"
        android:gravity="center_vertical"
        android:textColor="#101010"
        android:textSize="32px"
        android:text="asd啊收到"
        android:singleLine="true"
        android:maxLines="1"
        android:padding="3px"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tv_this_money"
        android:layout_width="0px"
        android:layout_weight="3"
        android:layout_height="match_parent"

        android:textSize="32px"
        android:text="@string/money_format"
        android:textColor="#e82f1e"
        android:gravity="center"
        android:padding="3px"
        />

    <com.yannuo.dgcanteen.views.AddDeleteCountView
        android:id="@+id/ad_add_subtract"
        android:layout_width="wrap_content"
        android:padding="3px"
        android:layout_height="match_parent"/>


</LinearLayout>