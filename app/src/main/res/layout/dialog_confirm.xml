<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_normal_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="30dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="500dp"
        android:minHeight="300dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text=""
            android:textColor="#4F4F4F"
            android:textSize="48sp" />

        <TextView
            android:id="@+id/tv_back_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:minHeight="50dp"
            android:text="自动关闭 3s"
            android:textColor="#FF6363"
            android:textSize="36sp"
            android:visibility="gone" />

        <RelativeLayout
            android:id="@+id/ll_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:visibility="gone">

            <Button
                android:id="@+id/cancel"
                android:layout_width="150dp"
                android:layout_height="70dp"
                android:layout_centerVertical="true"
                android:background="@drawable/shape_normal_gray"
                android:stateListAnimator="@null"
                android:text="取消"
                android:textColor="#FFFFFF"
                android:textSize="36sp" />

            <Button
                android:id="@+id/confirm"
                android:layout_width="150dp"
                android:layout_height="70dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/shape_normal_bt_bg"
                android:stateListAnimator="@null"
                android:text="确认"
                android:textColor="#FFFFFF"
                android:textSize="36sp" />
        </RelativeLayout>

    </LinearLayout>
</LinearLayout>