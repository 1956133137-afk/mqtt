<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:corner="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_marginLeft="10px"
    android:layout_marginRight="10px"
    android:layout_marginBottom="10px"
    app:cardCornerRadius="15px"
    app:cardBackgroundColor="@color/white"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout

        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/iv_pic"
            android:layout_width="180dp"
            android:layout_height="180dp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_marginTop="5px"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:paddingStart="18px"
                android:paddingBottom="13px"
                android:gravity="center_vertical"
                android:minWidth="250dp"
                android:textColor="#101010"
                android:textSize="28px"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <TextView
                android:id="@+id/tv_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="3px"
                android:paddingEnd="10px"
                android:paddingStart="18px"
                android:paddingTop="3px"
                android:singleLine="true"
                android:text="@string/money_format"
                android:textColor="#FFFF0000"
                android:textSize="15px"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/cv_count_add"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/cv_count_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10px"
                android:layout_marginEnd="10px"
                android:layout_marginTop="5px"
                android:text="2份"
                android:textSize="33sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_name"
         />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>