<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activitys.OrderVerifyActivity">

    <RelativeLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@color/white"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/meal_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:background="@drawable/shape_tv_bg"
            android:gravity="center"
            android:minWidth="380dp"
            android:minHeight="80dp"
            android:textColor="#4F4F4F"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:text="@string/dg_canteen"
            android:textColor="#4095E5"
            android:textSize="70sp"
            android:textStyle="bold" />

        <TextClock
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/im_server"
            android:format24Hour="yyyy-MM-dd HH:mm:ss"
            android:gravity="center"
            android:textColor="#4F4F4F"
            android:textSize="40sp" />

        <ImageButton
            android:id="@+id/im_server"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:layout_toStartOf="@+id/btn_setting"
            android:background="@color/transparency"
            android:src="@drawable/ic_server" />

        <Button
            android:id="@+id/btn_setting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/select_btn_blue_press"
            android:drawableStart="@drawable/ic_setting"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:stateListAnimator="@null"
            android:text="设置"
            android:textColor="#FFFFFF"
            android:textSize="40sp" />

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:background="@drawable/shape_bg_white_10"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/mode_tips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="80dp"
                android:textColor="#4F4F4F"
                android:textSize="50sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/verify_name_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:minHeight="80dp"
                android:textColor="#4F4F4F"
                android:textSize="50sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/verify_dish_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </LinearLayout>

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="10dp">

            <Button
                android:id="@+id/btn_verify_confirm"
                android:layout_width="250dp"
                android:layout_height="100dp"
                android:layout_centerHorizontal="true"
                android:background="@drawable/shape_btn_one"
                android:text="无需确认"
                android:textColor="#4F4F4F"
                android:textSize="45sp" />

            <Button
                android:id="@+id/btn_finish_verify"
                android:layout_width="250dp"
                android:layout_height="100dp"
                android:layout_below="@+id/btn_verify_confirm"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="20dp"
                android:background="@drawable/shape_bg_blue_10"
                android:text="完成核销"
                android:textColor="#FFFFFF"
                android:textSize="45sp" />

        </RelativeLayout>

    </LinearLayout>

</LinearLayout>