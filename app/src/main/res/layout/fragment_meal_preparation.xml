<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activitys.fragment.MealPreparationFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cly_calendar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/write_off_meal_info"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/v_title_bg"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@color/color_toji"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_statistic_Titel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="订单"
            android:textColor="@color/white"
            android:textSize="30sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_calendar_begin_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="50dp"
            android:layout_marginTop="25dp"
            android:background="@drawable/shape_bg_rect"
            android:drawableRight="@drawable/ic_calendar"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:text="          "
            android:textColor="@color/color_toji"
            android:textSize="27sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_statistic_Titel" />


        <TextView
            android:id="@+id/tv_calendar_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="至"
            android:textColor="@color/white"
            android:textSize="27sp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_calendar_begin_time"
            app:layout_constraintStart_toEndOf="@+id/tv_calendar_begin_time"
            app:layout_constraintTop_toTopOf="@+id/tv_calendar_begin_time" />

        <TextView
            android:id="@+id/tv_calendar_deadline_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginStart="20dp"
            android:background="@drawable/shape_bg_rect"
            android:drawableRight="@drawable/ic_calendar"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:text="          "
            android:textColor="@color/color_toji"
            android:textSize="27sp"
            app:layout_constraintStart_toEndOf="@+id/tv_calendar_time"
            app:layout_constraintTop_toTopOf="@+id/tv_calendar_begin_time" />

        <LinearLayout
            android:background="@drawable/shape_bg_rect"
            android:id="@+id/cb"
            android:layout_marginStart="20dp"
            android:checked="true"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="20dp"
            android:paddingBottom="4dp"
            app:layout_constraintStart_toEndOf="@+id/tv_calendar_deadline_time"
            app:layout_constraintTop_toTopOf="@+id/tv_calendar_deadline_time"
            android:layout_width="200dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:text="姓名: "
                android:textSize="27sp"
                android:textColor="@color/ic_app_background"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <EditText
                android:id="@+id/name_text"
                android:textSize="25sp"
                android:textColor="@color/creamy_white"
                android:background="@android:color/transparent"
                android:cursorVisible="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cb_success_or_fail_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:background="@drawable/shape_bg_rect"
            android:checked="true"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            app:layout_constraintStart_toEndOf="@+id/cb"
            app:layout_constraintTop_toTopOf="@+id/cb"
            android:orientation="horizontal">
            <TextView
                android:text="餐别："
                android:textSize="27sp"
                android:textColor="@color/ic_app_background"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <Spinner
                android:id="@+id/spinner_text"
                android:theme="@style/CustomSpinnerStyle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tv_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:background="@drawable/shape_bg_rect"
            android:drawableLeft="@drawable/ic_search"
            android:paddingLeft="30dp"
            android:paddingTop="4dp"
            android:paddingRight="30dp"
            android:paddingBottom="4dp"
            android:text="查询"
            android:textColor="@color/ic_app_background"
            android:textSize="30sp"
            app:layout_constraintBottom_toBottomOf="@+id/cb_success_or_fail_name"
            app:layout_constraintStart_toEndOf="@+id/cb_success_or_fail_name"
            app:layout_constraintTop_toTopOf="@+id/cb_success_or_fail_name" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_items"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="20dp"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_title_bg" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>