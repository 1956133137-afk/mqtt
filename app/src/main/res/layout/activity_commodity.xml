<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#F5F5F5"
    android:orientation="vertical"
    tools:context=".activitys.CommodityActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:gravity="center"
        android:background="@color/white"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/meal_time"
            android:layout_width="wrap_content"
            android:minWidth="350dp"
            android:layout_height="80dp"
            android:layout_marginStart="50dp"
            android:gravity="center"
            android:text="@string/unOpen_meal"
            android:textSize="35sp"
            android:background="@drawable/shape_tv_bg"/>

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:gravity="center"
            android:text="@string/dg_canteen"
            android:textStyle="bold"
            android:textColor="#4095E5"
            android:textSize="48sp"/>

        <TextView
            android:id="@+id/select_stopper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:textSize="24sp"
            android:textColor="#4F4F4F"/>

        <ImageButton
            android:id="@+id/on_off_line"
            android:layout_width="wrap_content"
            android:layout_height="27dp"
            android:layout_marginStart="30dp"
            android:background="@color/transparency"
            android:src="@drawable/ic_drama" />
        <ImageButton
            android:id="@+id/server"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:background="@color/transparency"
            android:src="@drawable/ic_server"/>
        <ImageButton
            android:id="@+id/network"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="50dp"
            android:background="@color/transparency"
            android:src="@drawable/ic_wifi"/>

    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="35dp"
            android:layout_marginStart="35dp"
            android:layout_marginTop="35dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <FrameLayout
                android:id="@+id/fl_pay_result"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginRight="20dp"
                android:layout_weight="5">


            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="18dp">

                <TextClock
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:format24Hour="yyyy-MM-dd HH:mm:ss"
                    android:gravity="center"
                    android:textColor="#4F4F4F"
                    android:textSize="38sp" />

                <Button
                    android:id="@+id/bt_back_pay"
                    android:layout_width="250dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="50dp"
                    android:background="@drawable/shape_normal_bt_bg"
                    android:text="支付解锁\n(选餐页面)"
                    android:textColor="#FFFFFF"
                    android:textSize="38sp" />

                <Button
                android:id="@+id/btn_setting"
                android:layout_width="250dp"
                android:layout_height="100dp"
                android:layout_marginTop="90dp"
                android:background="@drawable/shape_btn_one"
                android:text="@string/setting"
                android:textColor="#4F4F4F"
                android:textSize="38sp"/>
            <Button
                android:id="@+id/btn_dish_menu"
                android:layout_width="250dp"
                android:layout_height="100dp"
                android:layout_marginTop="90dp"
                android:background="@drawable/shape_btn_one"
                android:text="@string/dishes_manage"
                android:textColor="#4F4F4F"
                android:textSize="38sp"/>
            <Button
                android:id="@+id/btn_syn_dishes"
                android:layout_width="250dp"
                android:layout_height="100dp"
                android:layout_marginTop="90dp"
                android:background="@drawable/shape_btn_one"
                android:text="@string/syn_dish"
                android:textColor="#4F4F4F"
                android:textSize="38sp"/>

            </LinearLayout>

        </LinearLayout>

        <com.yannuo.dgcanteen.views.MoveTextview
            android:id="@+id/mv_control"
            android:textSize="50sp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            app:layout_constraintEnd_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>