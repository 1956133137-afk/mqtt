<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#F5F5F5"
    android:orientation="vertical"
    tools:context=".activitys.CommodityActivity">

    <TextView

        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="20dp"
        android:paddingBottom="10dp"
        android:background="@color/white"
        android:gravity="center"
        android:text="闪购"
        android:textStyle="bold"
        android:textColor="#4F4F4F"
        android:textSize="48sp"
        />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="18dp"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="1200dp"
            android:layout_height="match_parent"

            android:orientation="vertical">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tb_sub_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:tabIndicatorHeight="0dp"
                app:tabMode="scrollable"
                android:layout_gravity="center_horizontal"
                app:tabGravity="center"
                android:background="@drawable/shape_layout_bg"
                app:tabTextAppearance="@style/wallet_third_tab_layout"
                />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vp_people_info"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </LinearLayout>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_container_view"
            android:name="com.yannuo.dgcanteen.activitys.PayForFragment"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_marginLeft="20dp"
             />

    </LinearLayout>



</LinearLayout>