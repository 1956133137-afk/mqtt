<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#F5F5F5"
    android:orientation="vertical"
    tools:context=".activitys.CommodityActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:gravity="center"
        android:background="@color/white"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/meal_time"
            android:layout_width="420dp"
            android:layout_height="80dp"
            android:layout_marginStart="50dp"
            android:gravity="center"
            android:text="@string/breakfast_time"
            android:textSize="35sp"
            android:paddingStart="33dp"
            android:paddingEnd="13dp"
            android:background="@drawable/shape_tv_bg"
            android:drawableStart="@drawable/ic_noodles"/>

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="800dp"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:gravity="center"
            android:text="@string/dg_canteen"
            android:textStyle="bold"
            android:textColor="#4095E5"
            android:textSize="48sp"/>

        <TextView
            android:id="@+id/select_stopper"
            android:layout_width="365dp"
            android:layout_height="wrap_content"
            android:text="东港第二中学第一食堂 - 粉面档口"
            android:textSize="24sp"
            android:textColor="#4F4F4F"/>

        <ImageButton
            android:id="@+id/on_off_line"
            android:layout_width="wrap_content"
            android:layout_height="27dp"
            android:layout_marginStart="30dp"
            android:background="@color/transparency"
            android:src="@drawable/ic_drama" />
        <ImageButton
            android:id="@+id/server"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:background="@color/transparency"
            android:src="@drawable/ic_server"/>
        <ImageButton
            android:id="@+id/network"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="50dp"
            android:background="@color/transparency"
            android:src="@drawable/ic_wifi"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:padding="18dp">

    </LinearLayout>

</LinearLayout>