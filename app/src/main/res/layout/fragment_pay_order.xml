<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activitys.fragment.PayOrderFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_module_bg"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:padding="5dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="用户姓名:"
                android:textColor="#4F4F4F"
                android:textSize="35sp" />

            <EditText
                android:id="@+id/input_user_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:hint="请输入用户姓名"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#4F4F4F"
                android:textSize="35sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="订单编号:"
                android:textColor="#4F4F4F"
                android:textSize="35sp" />

            <EditText
                android:id="@+id/input_order_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:hint="请输入订单编号"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#4F4F4F"
                android:textSize="35sp" />
        </LinearLayout>

        <Button
            android:id="@+id/query_order"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:background="@drawable/select_btn_bg_blue_press"
            android:outlineProvider="none"
            android:padding="5dp"
            android:text="查询"
            android:textColor="#FFFFFF"
            android:textSize="35sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/shape_module_bg"
        android:orientation="horizontal"
        android:padding="5dp">

        <TextView
            android:id="@+id/date_msg"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/shape_direction_right"
            android:gravity="center"
            android:minWidth="220dp"
            android:textColor="#4F4F4F"
            android:textSize="35sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="60dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="交易总笔数"
                    android:textColor="#4F4F4F"
                    android:textSize="35sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="交易总余额"
                    android:textColor="#4F4F4F"
                    android:textSize="35sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="已上传数"
                    android:textColor="#4F4F4F"
                    android:textSize="35sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="未上传数"
                    android:textColor="#4F4F4F"
                    android:textSize="35sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="60dp">

                <TextView
                    android:id="@+id/tran_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="#4F4F4F"
                    android:textSize="35sp" />

                <TextView
                    android:id="@+id/tran_amount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="#4F4F4F"
                    android:textSize="35sp" />

                <TextView
                    android:id="@+id/already_upload_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="#4F4F4F"
                    android:textSize="35sp" />

                <TextView
                    android:id="@+id/not_upload_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="#4F4F4F"
                    android:textSize="35sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/scroll_view"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_module_bg"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:padding="5dp">

                <TextView
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="用户姓名"
                    android:textColor="#4F4F4F"
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="320dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="支付时间"
                    android:textColor="#4F4F4F"
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="付款金额"
                    android:textColor="#4F4F4F"
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="实付金额"
                    android:textColor="#4F4F4F"
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="支付类型"
                    android:textColor="#4F4F4F"
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="支付状态"
                    android:textColor="#4F4F4F"
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="上传状态"
                    android:textColor="#4F4F4F"
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="菜品详情"
                    android:textColor="#4F4F4F"
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="540dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="订单编号"
                    android:textColor="#4F4F4F"
                    android:textSize="32sp" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="wrap_content"
                android:layout_height="match_parent" />

        </LinearLayout>

    </HorizontalScrollView>

</LinearLayout>