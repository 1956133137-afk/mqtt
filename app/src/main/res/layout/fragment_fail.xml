<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF2323">

    <TextView
        android:id="@+id/back_auto_pay"
        android:layout_width="100dp"
        android:layout_height="100dp" />

    <Button
        android:id="@+id/btn_back"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_alignParentRight="true"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="60dp"
        android:background="@drawable/click_button_white"
        android:gravity="center"
        android:text="@string/btn_back"
        android:textColor="#4F4F4F"
        android:textSize="40sp" />

    <!--    <Button-->
    <!--        android:id="@+id/btn_close"-->
    <!--        android:layout_width="200dp"-->
    <!--        android:layout_height="80dp"-->
    <!--        android:layout_marginTop="60dp"-->
    <!--        android:layout_marginEnd="40dp"-->
    <!--        android:layout_toStartOf="@+id/btn_back"-->
    <!--        android:background="@drawable/click_button_blue"-->
    <!--        android:gravity="center"-->
    <!--        android:text="退出"-->
    <!--        android:textColor="#FFFFFF"-->
    <!--        android:textSize="40sp"-->
    <!--        android:visibility="gone" />-->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_hit_pic"
            android:layout_width="500dp"
            android:layout_height="500dp"
            android:src="@drawable/ic_pay_failure" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="李**"
                android:textColor="#FFFFFF"
                android:textSize="70sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="@string/pay_failure_title"
                android:textColor="#FFFFFF"
                android:textSize="70sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="800dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp">

            <TextView
                android:id="@+id/tv_title_reason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:minHeight="50dp"
                android:text="@string/pay_failure_reason"
                android:textColor="#FFFFFF"
                android:textSize="50sp" />

            <TextView
                android:id="@+id/pay_msg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="right"
                android:minHeight="50dp"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="50sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="800dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:minHeight="50dp"
                android:text="@string/pay_time"
                android:textColor="#FFFFFF"
                android:textSize="50sp" />

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="right"
                android:minHeight="50dp"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="50sp" />

        </LinearLayout>
    </LinearLayout>
</RelativeLayout>

