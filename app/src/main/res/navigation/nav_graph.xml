<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_host"
    app:startDestination="@id/host_fg">
    <fragment
        android:id="@+id/host_fg"
        android:name="com.yannuo.dgcanteen.activitys.fragment.FaceFragment"
        android:label="人脸"
        tools:layout="@layout/fragment_face">
        <action
            android:id="@+id/action_face_to_scan"
            app:destination="@id/scanFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/slide_in"
            app:popExitAnim="@anim/slide_out" />
        <action
            android:id="@+id/action_face_to_success"
            app:destination="@id/successFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/slide_in"
            app:popExitAnim="@anim/slide_out" />
        <action
            android:id="@+id/action_face_to_fail"
            app:destination="@id/failFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/slide_in"
            app:popExitAnim="@anim/slide_out" />
    </fragment>
    <fragment
        android:id="@+id/scanFragment"
        android:name="com.yannuo.dgcanteen.activitys.fragment.ScanFragment"
        android:label="fragment_style"
        tools:layout="@layout/fragment_scan">
        <action
            android:id="@+id/action_scan_to_fail"
            app:destination="@id/failFragment" />
        <action
            android:id="@+id/action_scan_to_success"
            app:destination="@id/successFragment" />

        <argument
            android:name="papData"
            app:argType="com.yannuo.dgcanteen.model.OrderPayInfo" />

    </fragment>
    <fragment
        android:id="@+id/successFragment"
        android:name="com.yannuo.dgcanteen.activitys.fragment.SuccessFragment"
        android:label="fragment_setting"
        tools:layout="@layout/fragment_success">
        <argument
            android:name="simpleForUI"
            app:argType="com.yannuo.dgcanteen.model.SimpleForUI" />
    </fragment>
    <fragment
        android:id="@+id/failFragment"
        android:name="com.yannuo.dgcanteen.activitys.fragment.FailFragment"
        android:label="fragment_about"
        tools:layout="@layout/fragment_fail">
        <argument
            android:name="simpleForUI"
            app:argType="com.yannuo.dgcanteen.model.SimpleForUI" />
    </fragment>
    <action android:id="@+id/action_global_scanFragment" app:destination="@id/scanFragment" />
    <action android:id="@+id/action_global_host_fg" app:destination="@id/host_fg" />
</navigation>